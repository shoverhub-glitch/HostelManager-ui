{
  "name": "hostel-manager",
  "version": "1.0.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "clean": "powershell -Command \"if (Test-Path .expo) { Remove-Item -Recurse -Force .expo }; if (Test-Path .turbo) { Remove-Item -Recurse -Force .turbo }; if (Test-Path node_modules) { Remove-Item -Recurse -Force node_modules }; if (Test-Path package-lock.json) { Remove-Item -Force package-lock.json }\"",
    "reset": "npm run clean && npm install"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "expo": "55.0.15",
    "expo-constants": "~55.0.13",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-linking": "~55.0.12",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "react-refresh": "^0.18.0",
    "typescript": "~5.9.2"
  }
}
